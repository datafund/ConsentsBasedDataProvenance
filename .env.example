# ---------------------------------------------------------------------------
# TESTNETS (sepolia, chiado, baseSepolia)
# ---------------------------------------------------------------------------
# Testnet deployer wallet private key (without 0x prefix).
# Only ever used for testnets: mainnet networks never read this variable.
TESTNET_DEPLOYER_PRIVATE_KEY=

# RPC URLs (defaults shown; replace with Alchemy/Infura for reliability)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
CHIADO_RPC_URL=https://rpc.chiadochain.net
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---------------------------------------------------------------------------
# MAINNETS (mainnet, gnosis, base) -- see docs/mainnet-deployment.md
# ---------------------------------------------------------------------------
# Mainnet signs on a Ledger hardware wallet. Put the Ledger account's PUBLIC
# address here, never a private key. Any *_PRIVATE_KEY / *_MNEMONIC variable
# that is not TESTNET_-prefixed makes Hardhat refuse every mainnet network.
MAINNET_DEPLOYER_ADDRESS=
# Gnosis Safe (threshold >= 2) that receives all admin rights after deploy.
# The mainnet deploy script refuses to run without it.
MAINNET_SAFE_ADDRESS=
# Ignition module the mainnet deploy script deploys.
# Required, no default: name it explicitly, e.g. ignition/modules/ConsentSystemV3.ts
MAINNET_IGNITION_MODULE=
# Mainnet RPC URLs (public defaults shown; use a dedicated provider for launch)
MAINNET_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
MAINNET_GNOSIS_RPC_URL=https://rpc.gnosischain.com
MAINNET_BASE_RPC_URL=https://mainnet.base.org

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Optional
REPORT_GAS=false
